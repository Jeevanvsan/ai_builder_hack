# Copy to .env.local and fill in. Firebase values: npx firebase-tools apps:sdkconfig WEB --project quickbite-5cde0
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=quickbite-5cde0.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quickbite-5cde0
VITE_FIREBASE_APP_ID=
# Gemini Live API key for the covert call flow. Get a free key at https://aistudio.google.com/api-keys
# Separate from the dashboard's own VITE_GEMINI_API_KEY (different app, keeps blast radius small if one leaks).
VITE_GEMINI_LIVE_API_KEY=
VITE_DRIVE_UPLOAD_URL=https://script.google.com/macros/s/XXXX/exec