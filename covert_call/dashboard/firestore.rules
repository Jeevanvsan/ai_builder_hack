rules_version = '2';

// Hackathon prototype: there is no sign-in yet, so these rules can't tell a responder from the QuickBite app or a
// stranger. Instead they only accept well-formed, forward-moving changes: no deletes, only known fields with valid
// values, statuses that never go backwards, append-only notes. Admin operations (seed --reset) go through the
// Firebase CLI, which is not subject to these rules. Add Firebase Auth before handling any real data.
service cloud.firestore {
  match /databases/{database}/documents {

    function statusRank(s) {
      return s == 'new' ? 0 : s == 'acknowledged' ? 1 : s == 'in_progress' ? 2 : 3;
    }

    function optionalString(d, key, maxLen) {
      return !(key in d) || d[key] == null || (d[key] is string && d[key].size() <= maxLen);
    }

    function validIncident(d) {
      return d.keys().hasAll(['sessionStartedAt', 'channel', 'callState', 'location', 'extractedFieldsLive', 'severity', 'response'])
        && d.keys().hasOnly([
          'sessionStartedAt', 'sessionEndedAt', 'channel', 'callState', 'location', 'extractedFieldsLive',
          'consolidatedSummary', 'fieldConfidence', 'transcriptSummary', 'voiceStressScore', 'voiceStressTrend',
          'leakageCheckStatus', 'severity', 'response', 'video'
        ])
        && d.sessionStartedAt is string
        && d.channel in ['live-call', 'silent-tap']
        && d.callState in ['active', 'ended']
        && d.severity in ['low', 'medium', 'high']
        && d.location is map
        && d.extractedFieldsLive is map
        && d.response is map
        && d.response.status in ['new', 'acknowledged', 'in_progress', 'resolved']
        && d.response.notes is list && d.response.notes.size() <= 200
        && (!('voiceStressTrend' in d) || (d.voiceStressTrend is list && d.voiceStressTrend.size() <= 2000))
        && (!('voiceStressScore' in d) || d.voiceStressScore == null || (d.voiceStressScore is number && d.voiceStressScore >= 0 && d.voiceStressScore <= 100))
        && (!('video' in d) || (d.video is map && d.video.status in ['live', 'ended']))
        && optionalString(d, 'consolidatedSummary', 5000)
        && optionalString(d, 'transcriptSummary', 5000);
    }

    // Only forward progress: status never goes back (resolved stays resolved), an ended call never goes live
    // again, the session's start and channel never change, and notes / stress history only grow.
    function validChange(before, after) {
      return statusRank(after.response.status) >= statusRank(before.response.status)
        && !(before.callState == 'ended' && after.callState == 'active')
        && after.sessionStartedAt == before.sessionStartedAt
        && after.channel == before.channel
        && after.response.notes.size() >= before.response.notes.size()
        && (!('voiceStressTrend' in before) || after.voiceStressTrend.size() >= before.voiceStressTrend.size());
    }

    match /incidents/{incidentId} {
      allow read: if true;
      allow create: if incidentId.matches('INC-[A-Za-z0-9-]{2,32}') && validIncident(request.resource.data);
      allow update: if validIncident(request.resource.data) && validChange(resource.data, request.resource.data);
      allow delete: if false;

      // WebRTC handshake for the live camera feed (Epic 7.1). A dashboard creates its offer doc, the phone adds
      // the answer, both add ICE candidates; the dashboard deletes its own doc when it stops watching.
      match /videoViewers/{viewerId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['offer', 'createdAt', 'viewerName'])
          && request.resource.data.offer is map
          && request.resource.data.createdAt is string;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
          && request.resource.data.answer is map;
        allow delete: if true;

        match /{side}/{candidateId} {
          allow read: if true;
          allow create: if side in ['viewerCandidates', 'publisherCandidates']
            && request.resource.data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment']);
          allow update: if false;
          allow delete: if true;
        }
      }
    }
  }
}
