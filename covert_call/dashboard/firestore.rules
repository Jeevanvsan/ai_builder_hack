rules_version = '2';

// Two writers hit `incidents`: the (unauthenticated) QuickBite app creating/updating a live call, and signed-in
// dashboard responders acting on it. `create` and the call's own live fields stay open to an anonymous caller;
// responder-only fields (status, acknowledgedBy, notes, viewedBy) require Firebase Auth once a status change or
// note is present in the write. Still no deletes, only known fields with valid values, statuses that never go
// backwards. Admin operations (seed --reset) go through the Firebase CLI, which is not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Epic 31: QuickBite callers now sign in anonymously too, so "signed in" no longer means "responder". Every
    // responder-only rule uses this: an email account with an active responders/ record.
    function isResponder() {
      return isSignedIn()
        && 'email' in request.auth.token
        && exists(/databases/$(database)/documents/responders/$(request.auth.token.email))
        && get(/databases/$(database)/documents/responders/$(request.auth.token.email)).data.status == 'active';
    }

    function myResponderDoc() {
      return get(/databases/$(database)/documents/responders/$(myResponderId()));
    }

    function myResponderId() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/responders/$(myResponderId()))
        && myResponderDoc().data.role == 'admin'
        && myResponderDoc().data.status == 'active';
    }

    function validResponder(d) {
      return d.keys().hasOnly(['name', 'email', 'role', 'status', 'createdAt', 'createdBy'])
        && d.keys().hasAll(['name', 'email', 'role', 'status'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.email is string && d.email.size() > 0
        && d.role in ['admin', 'responder']
        && d.status in ['active', 'disabled'];
    }

    // Bootstrap: the two hardcoded founding admins may create their own doc once, as an admin, if it doesn't
    // exist yet. Every other create/update/delete on this collection requires an existing active admin.
    function isBootstrapAdmin(email) {
      return isSignedIn()
        && request.auth.token.email == email
        && email in ['jeevan@quickbite.com', 'ameen@quickbite.com']
        && !exists(/databases/$(database)/documents/responders/$(email));
    }

    // Document id = responder's email (stable, known upfront by whoever adds them; no Admin SDK UID lookup needed).
    match /responders/{email} {
      allow read: if isSignedIn() && 'email' in request.auth.token;
      allow create: if validResponder(request.resource.data) && request.resource.data.email == email
        && (isAdmin() || (isBootstrapAdmin(email) && request.resource.data.role == 'admin' && request.resource.data.status == 'active'));
      allow update: if isAdmin() && validResponder(request.resource.data) && request.resource.data.email == email;
      allow delete: if isAdmin();
    }

    // Shared cache for the Analytics page's "AI Insights" tab — one Gemini result read by every responder,
    // regenerated at most once a day by whoever clicks Refresh (the app enforces the once-a-day cadence, the
    // rule just validates shape so this stays a plain text/insights cache, not an arbitrary write target).
    function validAiInsights(d) {
      return d.keys().hasOnly(['immediateActions', 'recommendations', 'suggestions', 'generatedAt', 'generatedBy'])
        && d.immediateActions is list && d.recommendations is list && d.suggestions is list
        && d.generatedAt is string && d.generatedBy is string;
    }

    match /analytics/aiInsights {
      allow read: if isResponder();
      allow write: if isResponder() && validAiInsights(request.resource.data);
    }

    function statusRank(s) {
      return s == 'new' ? 0 : s == 'acknowledged' ? 1 : s == 'in_progress' ? 2 : 3;
    }

    function optionalString(d, key, maxLen) {
      return !(key in d) || d[key] == null || (d[key] is string && d[key].size() <= maxLen);
    }

    function validIncident(d) {
      return d.keys().hasAll(['sessionStartedAt', 'channel', 'callState', 'location', 'extractedFieldsLive', 'severity', 'response'])
        && d.keys().hasOnly([
          'sessionStartedAt', 'sessionEndedAt', 'channel', 'incidentType', 'scenario', 'cameraMode', 'callState',
          'location', 'extractedFieldsLive', 'consolidatedSummary', 'fieldConfidence', 'fieldConfidenceLive',
          'transcriptSummary', 'transcriptLines', 'fieldHistory', 'reasoningTrace', 'recommendation', 'bulletin', 'groundedContext',
          'correlatedIncidentIds', 'safeRoute', 'consolidationFailed', 'recordingFailed',
          'voiceStressScore', 'voiceStressTrend', 'callerEstimate', 'leakageCheckStatus', 'severity', 'response', 'video', 'videoFront',
          'audioListen', 'hasRecording', 'videoRecording', 'audioRecording', 'sceneObservations', 'adviceGiven',
          'videoControl', 'vehicle', 'coercionSignals', 'motionEvents', 'isDemo', 'callerUid', 'credibility'
        ])
        && d.sessionStartedAt is string
        && d.channel in ['live-call', 'silent-tap', 'click-order', 'silent-sos']
        && (!('incidentType' in d) || d.incidentType in ['report', 'sos'])
        && (!('scenario' in d) || (d.scenario is string && d.scenario.size() <= 40))
        && (!('cameraMode' in d) || d.cameraMode in ['dual', 'alternating', 'back-only'])
        && d.callState in ['active', 'ended']
        && d.severity in ['low', 'medium', 'high']
        && d.location is map
        && (!('track' in d.location) || (d.location.track is list && d.location.track.size() <= 2000))
        && (!('safeRoute' in d) || d.safeRoute is map)
        && d.extractedFieldsLive is map
        && d.response is map
        && d.response.status in ['new', 'acknowledged', 'in_progress', 'resolved']
        && d.response.notes is list && d.response.notes.size() <= 200
        && (!('voiceStressTrend' in d) || (d.voiceStressTrend is list && d.voiceStressTrend.size() <= 2000))
        && (!('voiceStressScore' in d) || d.voiceStressScore == null || (d.voiceStressScore is number && d.voiceStressScore >= 0 && d.voiceStressScore <= 100))
        && (!('callerEstimate' in d) || d.callerEstimate is map)
        && (!('video' in d) || (d.video is map && d.video.status in ['live', 'ended']))
        && (!('videoFront' in d) || (d.videoFront is map && d.videoFront.status in ['live', 'ended']))
        && (!('audioListen' in d) || (d.audioListen is map && d.audioListen.status in ['live', 'ended']))
        // A responder asking the caller's phone to swap between its front and back camera. Only a request: the
        // phone decides whether it can act on it, and never writes back. Signed-in only, since an anonymous
        // caller has no reason to steer their own camera, and it would otherwise be an open write target.
        && (!('videoControl' in d) || (d.videoControl is map
          && d.videoControl.facing in ['front', 'back']
          && d.videoControl.requestedAt is string))
        && (!('hasRecording' in d) || d.hasRecording is bool)
        && (!('videoRecording' in d) || (d.videoRecording is list && d.videoRecording.size() <= 4))
        && (!('audioRecording' in d) || d.audioRecording is map)
        && (!('sceneObservations' in d) || (d.sceneObservations is list && d.sceneObservations.size() <= 2000))
        && (!('adviceGiven' in d) || (d.adviceGiven is list && d.adviceGiven.size() <= 500))
        && (!('fieldConfidenceLive' in d) || d.fieldConfidenceLive is map)
        && (!('reasoningTrace' in d) || (d.reasoningTrace is list && d.reasoningTrace.size() <= 500))
        && (!('transcriptLines' in d) || (d.transcriptLines is list && d.transcriptLines.size() <= 3000))
        && (!('fieldHistory' in d) || (d.fieldHistory is list && d.fieldHistory.size() <= 500))
        && (!('bulletin' in d) || d.bulletin is map)
        && (!('consolidationFailed' in d) || d.consolidationFailed is bool)
        && optionalString(d, 'recordingFailed', 300)
        && (!('correlatedIncidentIds' in d) || (d.correlatedIncidentIds is list && d.correlatedIncidentIds.size() <= 20))
        && optionalString(d, 'recommendation', 200)
        && optionalString(d, 'groundedContext', 300)
        && optionalString(d, 'consolidatedSummary', 5000)
        && optionalString(d, 'transcriptSummary', 5000)
        // Phase 4: suspect number plate (Epic 22.3), coercion signals (Epic 24), demo flag (Epic 25).
        && (!('vehicle' in d) || (d.vehicle is map && d.vehicle.number is string && d.vehicle.number.size() <= 20
          && d.vehicle.source in ['caller', 'camera']))
        && (!('coercionSignals' in d) || (d.coercionSignals is list && d.coercionSignals.size() <= 100))
        && (!('motionEvents' in d) || (d.motionEvents is list && d.motionEvents.size() <= 50))
        && (!('isDemo' in d) || d.isDemo is bool)
        // Epic 31: the caller's anonymous id (never their number) and the AI credibility check.
        && (!('callerUid' in d) || (d.callerUid is string && d.callerUid.size() <= 128))
        && (!('credibility' in d) || (d.credibility is map && d.credibility.score is number
          && d.credibility.level in ['likely-genuine', 'uncertain', 'possible-false'] && d.credibility.reasons is list))
        && (!('outcome' in d.response) || d.response.outcome in [null, 'genuine', 'false-alarm', 'prank']);
    }

    // Only forward progress: status never goes back (resolved stays resolved), an ended call never goes live
    // again, the session's start and channel never change, and notes / stress history only grow.
    function validChange(before, after) {
      return statusRank(after.response.status) >= statusRank(before.response.status)
        && !(before.callState == 'ended' && after.callState == 'active')
        && after.sessionStartedAt == before.sessionStartedAt
        && after.channel == before.channel
        && after.get('callerUid', null) == before.get('callerUid', null)
        && after.response.notes.size() >= before.response.notes.size()
        && (!('voiceStressTrend' in before) || after.voiceStressTrend.size() >= before.voiceStressTrend.size())
        && (!('reasoningTrace' in before) || after.reasoningTrace.size() >= before.reasoningTrace.size())
        && (!('transcriptLines' in before) || after.transcriptLines.size() >= before.transcriptLines.size());
    }

    // A responder action touches status, who acknowledged/viewed it, or adds a note — only a signed-in
    // responder may change these. The QuickBite app's own live-call writes never touch this block.
    function changesResponderFields(before, after) {
      return before.response.status != after.response.status
        || before.response.notes != after.response.notes
        || before.response.get('acknowledgedBy', null) != after.response.get('acknowledgedBy', null)
        || before.response.get('viewedAt', null) != after.response.get('viewedAt', null)
        || before.get('videoControl', null) != after.get('videoControl', null)
        || before.get('credibility', null) != after.get('credibility', null)
        || before.response.get('outcome', null) != after.response.get('outcome', null);
    }

    // Epic 31: a caller's profile. Only that caller writes it; only responders (and the caller) read it. The phone
    // number must be the one Firebase verified by OTP for this account, so it can't be made up.
    match /callers/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isResponder();
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['phone', 'phoneVerifiedAt', 'contacts', 'updatedAt'])
        && (!('phone' in request.resource.data) || request.resource.data.phone == null
          || request.resource.data.phone == request.auth.token.get('phone_number', ''))
        && (!('contacts' in request.resource.data) || (request.resource.data.contacts is list && request.resource.data.contacts.size() <= 3));
      allow delete: if false;
    }

    // Epic 31: devices a responder marked false alarm / prank (count only). Responders only.
    match /flaggedDevices/{uid} {
      allow read: if isResponder();
      allow write: if isResponder() && request.resource.data.falseCount is int && request.resource.data.falseCount >= 0;
    }

    // Epic 25: hidden demo calls. Same shape as a real incident so the call code is identical, but in its own
    // collection that the dashboard never reads. No responder fields are ever written here, and nothing is deleted.
    match /demoIncidents/{incidentId} {
      allow read: if true;
      allow create: if incidentId.matches('INC-[A-Za-z0-9-]{2,32}') && validIncident(request.resource.data)
        && (!('callerUid' in request.resource.data) || (isSignedIn() && request.resource.data.callerUid == request.auth.uid));
      allow update: if validIncident(request.resource.data) && validChange(resource.data, request.resource.data)
        && !changesResponderFields(resource.data, request.resource.data);
      allow delete: if false;
      // A demo call listens for responder messages like a real one; nobody can send any here.
      match /messages/{messageId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /incidents/{incidentId} {
      allow read: if true;
      allow create: if incidentId.matches('INC-[A-Za-z0-9-]{2,32}') && validIncident(request.resource.data)
        && (!('callerUid' in request.resource.data) || (isSignedIn() && request.resource.data.callerUid == request.auth.uid));
      allow update: if validIncident(request.resource.data) && validChange(resource.data, request.resource.data)
        && (!changesResponderFields(resource.data, request.resource.data) || isResponder());
      allow delete: if false;

      // Epic 23: responder -> caller messages, relayed by Mia. Only a signed-in responder can send one. The
      // QuickBite app (unauthenticated) may only flip a pending message to delivered and record what Mia said.
      match /messages/{messageId} {
        allow read: if true;
        allow create: if isResponder()
          && request.resource.data.keys().hasOnly(['text', 'sentBy', 'sentAt', 'status'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
          && request.resource.data.sentBy is string && request.resource.data.sentAt is string
          && request.resource.data.status == 'pending';
        allow update: if resource.data.status == 'pending' && request.resource.data.status == 'delivered'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'spokenAs', 'deliveredAt'])
          && request.resource.data.spokenAs is string && request.resource.data.spokenAs.size() <= 500;
        allow delete: if false;
      }

      // Full call recording (mic + AI voice), base64-encoded — saved here instead of Firebase Storage since
      // Storage now requires the paid Blaze plan and this project stays on the free tier. Written unauthenticated
      // by the QuickBite app on call end (same trust model as the incident doc itself); read is restricted to
      // signed-in responders since raw audio is far more sensitive than the extracted text fields.
      match /recording/{docId} {
        allow read: if isResponder();
        allow create: if docId == 'audio'
          && request.resource.data.keys().hasOnly(['base64', 'mimeType', 'savedAt'])
          && request.resource.data.base64 is string && request.resource.data.base64.size() < 1400000
          && request.resource.data.mimeType is string
          && request.resource.data.savedAt is string;
        allow update: if false;
        allow delete: if false;
      }

      // WebRTC handshake for the live camera feed (Epic 7.1). A dashboard creates its offer doc, the phone adds
      // the answer, both add ICE candidates; the dashboard deletes its own doc when it stops watching.
      match /videoViewers/{viewerId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['offer', 'createdAt', 'viewerName'])
          && request.resource.data.offer is map
          && request.resource.data.createdAt is string;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
          && request.resource.data.answer is map;
        allow delete: if true;

        match /{side}/{candidateId} {
          allow read: if true;
          allow create: if side in ['viewerCandidates', 'publisherCandidates']
            && request.resource.data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment']);
          allow update: if false;
          allow delete: if true;
        }
      }

      // Second live feed's handshake — the front camera of a dual-camera SOS (Epic 11). Same rules as videoViewers.
      match /videoViewersFront/{viewerId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['offer', 'createdAt', 'viewerName'])
          && request.resource.data.offer is map
          && request.resource.data.createdAt is string;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
          && request.resource.data.answer is map;
        allow delete: if true;

        match /{side}/{candidateId} {
          allow read: if true;
          allow create: if side in ['viewerCandidates', 'publisherCandidates']
            && request.resource.data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment']);
          allow update: if false;
          allow delete: if true;
        }
      }

      // Third live feed's handshake — the caller-mic listen-in audio channel (Epic 16). Same rules as videoViewers.
      match /audioViewers/{viewerId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['offer', 'createdAt', 'viewerName'])
          && request.resource.data.offer is map
          && request.resource.data.createdAt is string;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
          && request.resource.data.answer is map;
        allow delete: if true;

        match /{side}/{candidateId} {
          allow read: if true;
          allow create: if side in ['viewerCandidates', 'publisherCandidates']
            && request.resource.data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment']);
          allow update: if false;
          allow delete: if true;
        }
      }
    }
  }
}
