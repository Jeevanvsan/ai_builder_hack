# Copy to .env.local and fill in. Firebase values: npx firebase-tools apps:sdkconfig WEB --project quickbite-5cde0
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=quickbite-5cde0.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quickbite-5cde0
VITE_FIREBASE_APP_ID=
# Optional: without it the incident map falls back to OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: without it the Analytics page's "AI Insights" tab is hidden. Get a free key at https://aistudio.google.com/api-keys
VITE_GEMINI_API_KEY=
