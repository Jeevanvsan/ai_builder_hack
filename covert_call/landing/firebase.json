{
  "hosting": {
    "target": "landing",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [{ "source": "/privacy", "destination": "/index.html" }],
    "headers": [
      { "source": "/shots/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
      { "source": "/videos/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
    ]
  }
}
